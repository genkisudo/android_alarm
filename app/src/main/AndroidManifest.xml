<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SPEC.md #7 - this is the complete permission set. No INTERNET permission exists.
         Declared up front; the components that use each one are added phase by phase. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".SilentAlarmApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SilentAlarm">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SilentAlarm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- directBootAware: must run before first unlock so a reboot the user never unlocks
             still fires alarms (SPEC.md Assumption A8, test T16). -->
        <receiver
            android:name=".fire.AlarmReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- System-triggered firing screen (SPEC.md #4.3), not a user-navigable destination.
             showWhenLocked/turnScreenOn bring it up over the lock screen with the screen off;
             excludeFromRecents + singleInstance keep it out of the task switcher. -->
        <activity
            android:name=".fire.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SilentAlarm.Firing" />

        <!-- Holds the vibration + firing notification (SPEC.md #5). specialUse is the
             foreground-service type for a use case with no dedicated Android type; exact
             alarms are exempt from the background-FGS-start restriction that would otherwise
             block starting this from a broadcast receiver (SPEC.md Assumption A9). -->
        <service
            android:name=".fire.AlarmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>

    </application>
</manifest>
