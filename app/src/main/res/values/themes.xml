<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SilentAlarm" parent="android:Theme.Material.NoActionBar" />

    <!-- Firing screen theme (SPEC.md #4.3): shown over the lock screen with the screen off,
         so it must not inherit any transition that delays becoming visible. -->
    <style name="Theme.SilentAlarm.Firing" parent="Theme.SilentAlarm">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
